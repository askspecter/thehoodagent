# Copy to `web/.env.local` and fill in. NEVER commit .env.local
#
# ─── Session signing ────────────────────────────────────────────────────────
# Required. Signs the login cookie. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# ─── X (Twitter) sign-in ────────────────────────────────────────────────────
# Create an app at https://developer.x.com → your project → Keys and tokens.
# In the app's "User authentication settings" enable OAuth 2.0, set the app type
# to "Web App" (confidential client), and add the callback URL below verbatim.
X_CLIENT_ID=
X_CLIENT_SECRET=
# Must match the callback URL registered with X exactly, including scheme/port.
X_REDIRECT_URI=http://localhost:3000/api/auth/x/callback

# ─── Robinhood Chain RPC ────────────────────────────────────────────────────
# Public endpoints work; your own node or a provider is faster and won't rate-limit.
ROBINHOOD_RPC=https://rpc.chain.robinhood.com
ROBINHOOD_TESTNET_RPC=https://rpc.testnet.chain.robinhood.com
ROBINHOOD_EXPLORER=https://explorer.chain.robinhood.com

# How many recent blocks to replay when computing holder concentration.
# Higher = more accurate, slower. 30000 is a reasonable web default.
AUDIT_MAX_BLOCKS=30000

# ─── Pons contract overrides ────────────────────────────────────────────────
# ⚠️  The defaults in agent/lib/chains.js came from third-party reporting of the
#     Pons docs, NOT from reading the official docs directly. VERIFY each against
#     https://docs.ponsfamily.com/ and the block explorer, then set them here.
#     A wrong router address is how wallets get drained.
PONS_FACTORY=
PONS_ROUTER=
PONS_QUOTER=
ROBINHOOD_WETH=
