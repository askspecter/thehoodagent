# Copy this file to `.env` and fill it in. NEVER commit `.env`.
#
# ⚠️  PRIVATE_KEY controls real money. Anyone who has it can drain your wallet.
#     Use a FRESH wallet for deployment, funded with only the gas you need.
#     Never paste this key into a chat, a website, or a support DM.
PRIVATE_KEY=

# Address that receives the full 1,000,000,000 PONS supply at deployment.
# Leave blank to use the deployer wallet itself.
TREASURY_ADDRESS=

# RPC endpoints (defaults in hardhat.config.js work, but your own is faster/reliable)
BSC_TESTNET_RPC=
BASE_SEPOLIA_RPC=
BSC_RPC=
BASE_RPC=
ETH_RPC=

# Block explorer API keys — only needed to verify the contract source publicly.
BSCSCAN_API_KEY=
BASESCAN_API_KEY=
ETHERSCAN_API_KEY=
