# Copy to `.env.local` and fill in. NEVER commit `.env.local`.
#
# On Vercel, set these under Settings → Environment Variables instead.

# ─── Session signing (required) ─────────────────────────────────────────────
# Signs the login cookie. Without it the app returns a setup error instead of
# signing anyone in. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# ─── X (Twitter) sign-in ────────────────────────────────────────────────────
# Create an app at https://developer.x.com → your project → Keys and tokens.
# In "User authentication settings": enable OAuth 2.0, App type = Web App
# (confidential client), and register the callback URL below verbatim.
X_CLIENT_ID=
X_CLIENT_SECRET=
# Must match what X has registered EXACTLY, including scheme and path.
# Local:      http://localhost:3000/api/auth/x/callback
# Production: https://<your-domain>/api/auth/x/callback
X_REDIRECT_URI=http://localhost:3000/api/auth/x/callback

# ─── Robinhood Chain RPC ────────────────────────────────────────────────────
# The public endpoint works, but the pons docs warn it times out on wide
# eth_getLogs ranges. A private RPC is faster and won't rate-limit you.
ROBINHOOD_RPC=https://rpc.mainnet.chain.robinhood.com
ROBINHOOD_EXPLORER=https://robinhoodchain.blockscout.com

# How many recent blocks to replay for holder concentration. Higher = more
# accurate, slower. Lower this if audits time out on a serverless host.
AUDIT_MAX_BLOCKS=30000

# ─── pons contract overrides (optional) ─────────────────────────────────────
# Defaults in lib/engine/chains.js come from the official pons docs. Override
# here if pons ships a new factory, or to pin your own verified addresses.
PONS_FACTORY=
PONS_ROUTER=
PONS_QUOTER=
ROBINHOOD_WETH=

# ─── Contract deployment (only for deploying your own token) ────────────────
# ⚠️  Controls real money. Use a FRESH wallet holding only the gas you need.
#     Never paste this into a chat, a website, or a "support" DM.
#     Not needed to run the website.
PRIVATE_KEY=
TREASURY_ADDRESS=
BSCSCAN_API_KEY=
BASESCAN_API_KEY=
ETHERSCAN_API_KEY=
